PORT=3000

# The COMPLEX MANAGEMENT Supabase project (ref khkjzsddztzaofbnrkue) -- the same project the
# apartment system uses, because restaurant owners sign in against its auth.users pool. We do not
# touch that system's public.users / roles / tenants tables; see src/db/schema.sql.
SUPABASE_URL=https://khkjzsddztzaofbnrkue.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# REQUIRED SETUP, not an env var: add `restaurant` under Settings -> API -> Exposed schemas in
# that project. PostgREST only serves schemas on that list, and the service-role key does not
# change that -- it bypasses RLS, not schema exposure. Without it every query 404s.

# --- Billing (cross-project) ---------------------------------------------------------------
# Subscriptions live in the OTHER project (subscription_management_system, ref
# ocbdjpfskwcuzdlcryvv), which is a separate Postgres instance -- so there is no foreign key and
# no join. "Is this restaurant paid up?" is an HTTP call to that app's API, cached 5 minutes and
# FAILING OPEN, exactly like its own /api/site/status does for customer websites.
#
# Leave both blank and the gate is simply off: every console is writable. That is the right
# default for local dev and for the window before the endpoint below is deployed -- an
# unconfigured gate must not lock out every customer.
#
# Requires GET /api/site/subscription in subscription_management_system (see
# docs/subscription-endpoint.js in this repo -- paste it into that project's src/routes/site.js).
SUBSCRIPTION_API_URL=https://subscription-management-api.vercel.app
# Shared secret, sent as the x-platform-secret header. Any long random string; must match the
# PLATFORM_SECRET set on the subscription API.
SUBSCRIPTION_API_SECRET=

# The reverse direction: subscription_management_system's admin calls POST /api/platform/provision
# here, right after creating a restaurant customer's billing subscription there, to create the
# owner's login (a Supabase Auth account + staff row, in THIS project) and the restaurants row in
# one request -- see src/routes/platform.js. Any long random string; must match RESTAURANT_API_SECRET
# set on the subscription API. Leave blank and that endpoint refuses every request rather than
# comparing two undefineds and letting one through.
PROVISION_SECRET=

# Allowed CORS origins for the console, comma-separated. Any localhost port is allowed off
# production, matching subscription_management_system's server.js.
ADMIN_ORIGIN=https://res.complexai.co.za

# Where the printed coasters point. The API serves this to the console as `qr_target_url`, and
# it is the exact string you feed the QR generator in subscription_management_system. Changing
# it after a print run invalidates that run -- treat it as permanent.
#
# A dev value here is not harmless: it encodes into a real QR as cleanly as the real host, and
# nothing downstream can tell. The console warns when this resolves to localhost, which is the
# only thing standing between a laptop address and a print run.
PUBLIC_BASE_URL=https://menu.complexai.co.za

# Alerts. complexai.co.za must be VERIFIED in Resend with DNS at Host Africa before any of this
# reaches a restaurant owner -- an unverified sender only delivers to the Resend account's own
# address, which would silently swallow every alert.
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@complexai.co.za

# Salt for hashing diner IPs (abuse detection only). Any long random string; changing it resets
# the ability to correlate past submissions, which is a feature if it ever leaks.
IP_HASH_SALT=

# Vercel sends this automatically as `Authorization: Bearer <value>` on the cron route.
CRON_SECRET=

# --- scripts/smoke.js (end-to-end test) -----------------------------------------------------
# The project's anon/publishable key, and an email that has a restaurant.staff row with
# is_admin = true. Used only by `npm run smoke`; the server itself never reads these.
SMOKE_ANON=
SMOKE_EMAIL=

# Where alert emails link to. The console, not the API.
CONSOLE_URL=https://res.complexai.co.za
